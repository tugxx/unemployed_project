{
  "manifest_version": 3,
  "name": "WASM Hacker Pro",
  "version": "1.0",
  "description": "Auto Injector & RAM Scanner cho Web Game",
  "permissions": [
    "nativeMessaging",
    "debugger",
    "tabs",
    "storage",
    "permissions",
    "scripting"
  ],
  "host_permissions": ["<all_urls>"],
  "optional_host_permissions": ["*://*/*"],
  "action": {
    "default_title": "Bật/Tắt bảng điều khiển"
  },
  "background": {
    "service_worker": "dist/background.bundle.js"
  }
}
