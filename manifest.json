{
  "manifest_version": 3,
  "name": "WASM Hacker Pro",
  "version": "1.0",
  "description": "Auto Injector & RAM Scanner cho Web Game",
  "permissions": ["storage", "action", "activeTab"],
  "action": {
    "default_title": "Bật/Tắt bảng điều khiển"
  },
  "background": {
    "service_worker": "dist/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.poki.com/*",
        "*://*.crazygames.com/*",
        "*://*.y8.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["dist/content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "dist/memory_hooker.js",
        "dist/scanner_engine.js",
        "dist/screen_selector.js",
        "dist/binary_matcher.js",
        "dist/memory_writer.js",
        "dist/ui_view.js"
      ],
      "matches": [
        "*://*.poki.com/*",
        "*://*.crazygames.com/*",
        "*://*.y8.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    }
  ]
}
