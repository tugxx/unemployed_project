{
    "manifest_version": 3,
    "name": "WASM Hacker Pro",
    "version": "1.0",
    "description": "Auto Injector & RAM Scanner cho Web Game",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Bảng điều khiển WASM Hacker"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "all_frames": true,
            "run_at": "document_start",
            "js": [
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "core_controller.js",
                "ui_view.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}