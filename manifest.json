{
    "manifest_version": 3,
    "name": "WASM Hacker Pro",
    "version": "1.0",
    "description": "Auto Injector & RAM Scanner cho Web Game",
    "permissions": [
        "storage",
        "action"
    ],
    "action": {
        "default_title": "Bật/Tắt bảng điều khiển"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "all_frames": true,
            "run_at": "document_start",
            "js": [
                "content.js"
            ]
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "core_controller.js",
                "ui_view.js"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}